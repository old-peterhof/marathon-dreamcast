*.o
# Emitted by -MMD -MP alongside the .o files, and regenerated by every build.
# 161 of them were tracked, which is why the tree looked dirty after `clean`
# and why toggling GL=1 produced a hundred files of churn.
*.d
# The configuration stamp: its name is a hash of DEFINES, so it changes whenever
# the build configuration does. A build artifact, not a record.
.config-*
*.elf
*.cdi
*.gdi
*.bin
.DS_Store
data/
disc/

# Generated by the UI prototype's own tools -- reproducible, so not carried.
# shots/  : python3 shots.py --sheet --cols=3 --overscan
# assets/ : python3 plate.py   (the baked plates ARE kept; they are the handoff)
mockups/prototype/shots/
mockups/prototype/__pycache__/
