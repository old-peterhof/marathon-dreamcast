# Makefile.dc -- Aleph One 0.12.0 for Sega Dreamcast
#
# Derived from BERO's 2002 Makefile.dc (AlephOne-0.12.0-dc-1), rewritten for a
# modern KallistiOS toolchain. The 2002 original hardcoded /prog/kos-1.1.7 and
# /prog/SDL-1.2.5; everything here comes from environ.sh instead.
#
# Do not call this directly -- use ./build.sh, which sources environ.sh first.

ifndef KOS_BASE
$(error KOS_BASE is not set. Run ./build.sh instead of calling make directly.)
endif

TARGET   = alephone.elf

# ---------------------------------------------------------------------------
# Build identity
#
# Every image is named alephone-b<N>-<slug>.cdi and the same "b<N> <slug>" is
# drawn on the main menu, so feedback like "b17 turns too fast" is unambiguous.
# tools/new-build.sh bumps these and records the change in BUILDS.md.
# ---------------------------------------------------------------------------
BUILD_NUM  := $(shell cat BUILD_NUMBER 2>/dev/null || echo 0)
BUILD_SLUG := $(shell cat BUILD_NAME 2>/dev/null || echo dev)
BUILD_HASH := $(shell git rev-parse --short HEAD 2>/dev/null || echo nogit)
BUILD_TAG  := b$(BUILD_NUM)-$(BUILD_SLUG)

CS = Source_Files/CSeries
EP = Source_Files/Expat
MI = Source_Files/Misc
NW = Source_Files/Network
PF = Source_Files/Pfhortran
MV = Source_Files/ModelView

# ---------------------------------------------------------------------------
# Flags
#
# -std=gnu++98      this is 2002 C++; gcc 15 defaults to C++17 and rejects it
# -fpermissive      old-style conversions the modern front end treats as errors
# -fno-strict-aliasing  the renderer type-puns constantly
# -fno-rtti -fno-exceptions  BERO's port replaced try/throw with goto for this
# ---------------------------------------------------------------------------

SDL_INCS = -I$(KOS_PORTS)/include/SDL
# SDL 1.2's Dreamcast video backend calls into KOS's GL (glKosInit,
# glKosSwapBuffers and ~48 core gl* entry points), so -lGL is required even
# though Aleph One itself is built without HAVE_OPENGL and uses the software
# renderer. Verified with nm: our own OGL_*.o reference zero gl symbols.
SDL_LIBS = -lSDL -lGL -lz

INCS    = $(SDL_INCS) -Idc/vendor -I$(CS) -I$(EP) -I$(MI) -I$(NW) -I$(PF) -I$(MV)
DEFINES = -DSDL -DHAVE_UNISTD_H -DPACKAGE='"AlephOne"' -DVERSION='"0.12.0"' -DDC

# GL=1 selects BERO's untested hardware-accelerated path. IT DOES NOT COMPILE,
# and is kept only as a documented starting point for anyone who wants to try.
#
# KOS's GL (GLdc) is a subset, and every entry point Aleph One's GL renderer
# needs from outside that subset is absent:
#
#   glClipPlane / GL_CLIP_PLANE0..4   portal and liquid-surface clipping
#   glNewList glEndList glCallList    display lists, used for text
#   glGenLists glDeleteLists GL_COMPILE
#   glPushAttrib                      attribute stack
#   glLoadMatrixd glGetDoublev        double-precision matrices
#   glVertex2s                        short vertices
#   GL_COLOR_LOGIC_OP
#
# The small ones substitute trivially (glVertex2f, glLoadMatrixf). The clip
# planes do not: OGL_Render.cpp uses five of them for the core view frustum and
# water surfaces, so emulating them means clipping geometry in software before
# submission -- a renderer rewrite, not a port. See OVERNIGHT-LOG.md.
ifdef GL
DEFINES += -DHAVE_OPENGL
endif

# -MMD -MP emit a .d file per object listing the headers it used, pulled in at
# the bottom of this file. Without them a header edit rebuilds nothing and the
# link quietly ships stale objects -- changing SENS_DEFAULT in preferences.h
# left the old value compiled in, and an earlier session lost time the same way
# with movement bindings.
DEPFLAGS = -MMD -MP

COMPAT   = -fno-strict-aliasing -fpermissive -Wno-write-strings -Wno-narrowing
CFLAGS   = $(KOS_CFLAGS) $(INCS) $(DEFINES) $(COMPAT) $(DEPFLAGS)
CXXFLAGS = $(CFLAGS) -std=gnu++98 -fno-rtti -fno-exceptions

HOST_CC  = cc

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------

SRCS = \
  $(CS)/byte_swapping.cpp $(CS)/csalerts_sdl.cpp $(CS)/cscluts_sdl.cpp \
  $(CS)/csmisc_sdl.cpp $(CS)/csstrings_sdl.cpp \
  \
  $(EP)/hashtable.c $(EP)/xmlparse.c $(EP)/xmlrole.c $(EP)/xmltok.c \
  \
  $(MI)/AnimatedTextures.cpp $(MI)/ChaseCam.cpp $(MI)/ColorParser.cpp \
  $(MI)/Crosshairs_SDL.cpp $(MI)/DamageParser.cpp $(MI)/FileHandler_SDL.cpp \
  $(MI)/FontHandler.cpp $(MI)/ImageLoader_SDL.cpp $(MI)/OGL_Render.cpp \
  $(MI)/OGL_Setup.cpp $(MI)/OverheadMap_SDL.cpp $(MI)/OverheadMapRenderer.cpp \
  $(MI)/PlayerName.cpp $(MI)/RenderPlaceObjs.cpp $(MI)/RenderRasterize.cpp \
  $(MI)/RenderSortPoly.cpp $(MI)/RenderVisTree.cpp $(MI)/ShapesParser.cpp \
  $(MI)/TextStrings.cpp $(MI)/ViewControl.cpp $(MI)/XML_Configure.cpp \
  $(MI)/XML_DataBlock.cpp $(MI)/XML_ElementParser.cpp $(MI)/XML_LevelScript.cpp \
  $(MI)/XML_MakeRoot.cpp $(MI)/XML_Loader_SDL.cpp $(MI)/computer_interface.cpp \
  $(MI)/crc.cpp $(MI)/devices.cpp $(MI)/dynamic_limits.cpp $(MI)/effects.cpp \
  $(MI)/fades.cpp $(MI)/find_files_sdl.cpp $(MI)/flood_map.cpp \
  $(MI)/game_errors.cpp $(MI)/game_wad.cpp $(MI)/game_window.cpp \
  $(MI)/game_window_sdl.cpp $(MI)/images.cpp $(MI)/import_definitions.cpp \
  $(MI)/interface.cpp $(MI)/interface_sdl.cpp $(MI)/items.cpp \
  $(MI)/lightsource.cpp $(MI)/map.cpp $(MI)/map_constructors.cpp \
  $(MI)/marathon2.cpp $(MI)/media.cpp $(MI)/monsters.cpp \
  $(MI)/motion_sensor.cpp $(MI)/mouse_sdl.cpp $(MI)/mysound.cpp \
  $(MI)/overhead_map.cpp $(MI)/pathfinding.cpp $(MI)/physics.cpp \
  $(MI)/placement.cpp $(MI)/platforms.cpp $(MI)/player.cpp \
  $(MI)/preferences.cpp $(MI)/preprocess_map_sdl.cpp $(MI)/projectiles.cpp \
  $(MI)/render.cpp $(MI)/resource_manager.cpp $(MI)/scenery.cpp \
  $(MI)/scottish_textures.cpp $(MI)/screen_drawing.cpp \
  $(MI)/screen_sdl.cpp $(MI)/sdl_dialogs.cpp $(MI)/sdl_fonts.cpp \
  $(MI)/sdl_widgets.cpp $(MI)/shapes.cpp $(MI)/shell.cpp $(MI)/textures.cpp \
  $(MI)/vbl.cpp $(MI)/vbl_sdl.cpp $(MI)/wad.cpp $(MI)/wad_sdl.cpp \
  $(MI)/wad_prefs.cpp $(MI)/weapons.cpp $(MI)/world.cpp \
  $(MI)/shell_misc.cpp $(MI)/HUDRenderer.cpp $(MI)/HUDRenderer_SW.cpp \
  \
  $(NW)/network_dummy.cpp $(NW)/network_games.cpp \
  \
  $(PF)/script_instructions.cpp $(PF)/script_parser.cpp $(PF)/scripting.cpp

# BERO's dc/syscalls.c and dc/fs_mem.c targeted KOS 1.1.7 and cannot be reused:
# syscalls.c duplicates newlib symbols modern KOS already provides, and fs_mem.c
# reimplements what is now fs_ramdisk. dc/dc_compat.c supplies the two pieces
# that are actually still missing -- fs_mem_init() and access().
DC_OBJS = dc/dc_compat.o dc/dc_input.o dc/dc_vmu.o dc/dc_profiler.o \
          dc/dc_maple.o dc/dc_blit.o dc/dc_wad.o dc/vendor/sh4zam_src/shz_mem_sh4.o \
          dc/vendor/vmu_profiler.o

OBJS0 = $(SRCS:.cpp=.o)
OBJS  = $(OBJS0:.c=.o) $(DC_OBJS)

# BERO's Makefile linked $(KOS_BASE)/kernel/arch/dreamcast/kernel/startup.o by
# hand, as KOS 1.1.7 required. Modern KOS pulls startup in through libkallisti
# (_kos_startup.o) and its own linker script, so naming it again gives
# "multiple definition of _arch_mem_top". This is also why environ.sh leaves
# KOS_START empty. Nothing to add here -- KOS_LDFLAGS already has it covered.

# KOS_LDFLAGS passes -nostdlib and KOS_LIBS covers only C (-lkallisti -lm -lc
# -lgcc), so the C++ runtime has to be named explicitly: std::string, std::list
# and std::map all pull in libstdc++, and operator new/delete live in libsupc++.
# These go before KOS_LIBS so that the libc references inside libstdc++ resolve
# against the --start-group that follows.
CXXLIBS = -lstdc++ -lsupc++
LIBS    = $(SDL_LIBS) $(CXXLIBS) $(KOS_LIBS)

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

all: $(TARGET)

dc/build_id.h: BUILD_NUMBER BUILD_NAME
	@printf '/* generated by Makefile.dc -- do not edit */\n' > $@
	@printf '#define DC_BUILD_NUM  "%s"\n'  "$(BUILD_NUM)"  >> $@
	@printf '#define DC_BUILD_SLUG "%s"\n'  "$(BUILD_SLUG)" >> $@
	@printf '#define DC_BUILD_HASH "%s"\n'  "$(BUILD_HASH)" >> $@
	@printf '#define DC_BUILD_TAG  "b%s %s"\n' "$(BUILD_NUM)" "$(BUILD_SLUG)" >> $@

$(MI)/shell.o: dc/build_id.h
dc/dc_profiler.o: dc/build_id.h

$(TARGET): $(OBJS)
	$(KOS_CCPLUS) $(KOS_LDFLAGS) $(OBJS) -o $@ $(LIBS)

%.o: %.cpp
	$(KOS_CCPLUS) $(CXXFLAGS) -c $< -o $@

# gcc 15's SH4 backend miscompiles weapons.cpp at -O2. After a mul.l it emits
#
#	mul.l	r1,r8
#	mov.w	r0,@(10,macl)
#
# using MACL -- the multiply-accumulate result register -- as the base register
# of a displacement address. MACL is not a GPR and cannot be addressed that way;
# the backend should have issued `sts macl,rN` first. The assembler rejects it:
#	Error: syntax error in @(disp,[Rn, gbr, pc])
# -O1 does not hit the faulty pattern. This is game logic rather than renderer
# code, so the lost optimisation costs us nothing measurable.
Source_Files/Misc/weapons.o: CXXFLAGS += -O1

%.o: %.c
	$(KOS_CC) $(CFLAGS) -c $< -o $@

# sh4zam's hand-written SH4 assembly. Vendored rather than built through its
# kos-port, which needs cmake; this keeps the build self-contained.
%.o: %.s
	$(KOS_CC) $(KOS_CFLAGS) -c $< -o $@

# Aleph One 0.12.0 selects its platform layer by #including one .cpp from
# another, so these files never get an object of their own and make cannot see
# that they are inputs. Without these rules an edit to shell_sdl.cpp (or any of
# the others) silently produces an unchanged binary -- which cost real time
# before it was noticed. BERO's Makefile carried the shell.o line for exactly
# this reason; the rest were missing there too.
$(MI)/shell.o:              $(MI)/shell_sdl.cpp
$(MI)/preferences.o:        $(MI)/preferences_sdl.cpp
$(MI)/images.o:             $(MI)/images_sdl.cpp
$(MI)/computer_interface.o: $(MI)/computer_interface_sdl.cpp
$(MI)/screen_drawing.o:     $(MI)/screen_drawing_sdl.cpp
$(MI)/shapes.o:             $(MI)/shapes_sdl.cpp
$(MI)/mysound.o:            $(MI)/sound_sdl.cpp
$(MI)/scottish_textures.o:  $(MI)/low_level_textures.cpp
$(MI)/screen_sdl.o:         $(MI)/screen_shared.cpp

# BERO's Makefile rebuilt Expat's name table via a host tool it called
# genmtab.c. No such file exists in Aleph One 0.12.0 -- the generator here is
# gennmtab.c, and nametab.h ships pre-generated (dated 2001) exactly as upstream
# Makefile.am expects. So there is nothing to generate; xmltok.c just includes
# the checked-in header.

# ---------------------------------------------------------------------------
# Disc images
#
# The game looks for its data at /cd/AlephOne (shell_sdl.cpp), so the ISO needs
# an AlephOne directory at the root. Its contents come from two places: the MML,
# Fonts and Themes in disc-AlephOne/ that shipped with BERO's port, and the
# Images/Map/Shapes/Sounds from the Marathon 2 demo (tools/fetch-data.sh).
# ---------------------------------------------------------------------------

MKDCDISC = /opt/toolchains/dc/mkdcdisc/build/mkdcdisc
DISC     = disc
GAMEDATA = data/game
DISCNAME = Marathon 2

# Fixed disc serial. mkdcdisc otherwise derives one from a hash of the boot
# binary, so every build gets a different serial -- and Flycast keys its
# emulated VMU on that, handing each build a blank memory card. Saved games and
# preferences then never survive from one build to the next, which looks exactly
# like the VMU code being broken. Pinning it means all builds share one card,
# the way one console and one physical VMU do.
DISCSERIAL = MARATHON2
DISCAUTH = Bungie / BERO

$(GAMEDATA)/Map:
	./tools/fetch-data.sh

# disc/AlephOne is the tree the game reads as /cd/AlephOne. Two sources: the
# MML, Fonts and Themes from BERO's port (the SDL interface needs them), and the
# four retail data files fetched by tools/fetch-data.sh.
$(DISC)/.stamp: $(GAMEDATA)/Map
	rm -rf $(DISC)
	mkdir -p $(DISC)/AlephOne
	cp -R disc-AlephOne/. $(DISC)/AlephOne/
	cp $(GAMEDATA)/Map $(GAMEDATA)/Shapes $(GAMEDATA)/Sounds $(GAMEDATA)/Images \
		$(DISC)/AlephOne/
	touch $@


disc: $(DISC)/.stamp

# Emulator image: -N skips data-track padding, so it is ~20MB instead of ~700MB.
# Fine under Flycast. Do NOT burn this or put it on a GDEMU -- padding is what
# makes the image boot on real hardware.
test: $(TARGET) $(DISC)/.stamp
	rm -f $(DISC)/AlephOne/AUTOSTART $(DISC)/AlephOne/PADTEST $(DISC)/AlephOne/DEBUG $(DISC)/AlephOne/PROFILE
	echo auto > $(DISC)/AlephOne/AUTOSTART
	echo pad  > $(DISC)/AlephOne/PADTEST
	echo on   > $(DISC)/AlephOne/DEBUG
	$(MKDCDISC) -e $(TARGET) -d $(DISC)/AlephOne -o alephone-$(BUILD_TAG)-test.cdi \
		-s $(DISCSERIAL) -n "$(DISCNAME) $(BUILD_TAG)" -a "$(DISCAUTH)" -N

# Hands-on image for Flycast: starts a level by itself and keeps tracing, but
# leaves PADTEST off so a real controller drives the game rather than fighting
# the synthetic stick. This is the one to use when a human is testing with a pad
# plugged in -- `test` is for unattended runs.
play: $(TARGET) $(DISC)/.stamp
	rm -f $(DISC)/AlephOne/AUTOSTART $(DISC)/AlephOne/PADTEST $(DISC)/AlephOne/DEBUG $(DISC)/AlephOne/PROFILE
	echo auto > $(DISC)/AlephOne/AUTOSTART
	echo on   > $(DISC)/AlephOne/DEBUG
	$(MKDCDISC) -e $(TARGET) -d $(DISC)/AlephOne -o alephone-$(BUILD_TAG)-play.cdi \
		-s $(DISCSERIAL) -n "$(DISCNAME) $(BUILD_TAG)" -a "$(DISCAUTH)" -N

# Hardware image: padded. Larger, but this is the one that actually boots on a
# console or from GDEMU.
cdi: $(TARGET) $(DISC)/.stamp
	rm -f $(DISC)/AlephOne/AUTOSTART $(DISC)/AlephOne/PADTEST $(DISC)/AlephOne/DEBUG $(DISC)/AlephOne/PROFILE
	$(MKDCDISC) -e $(TARGET) -d $(DISC)/AlephOne -o alephone-$(BUILD_TAG).cdi \
		-s $(DISCSERIAL) -n "$(DISCNAME) $(BUILD_TAG)" -a "$(DISCAUTH)"

# Padded like `cdi`, so it boots on a console, but keeps the DEBUG marker so
# dc_trace() output is drawn on screen with bfont. For diagnosing hardware-only
# problems where there is no serial console to read.
cdi-debug: $(TARGET) $(DISC)/.stamp
	rm -f $(DISC)/AlephOne/AUTOSTART $(DISC)/AlephOne/PADTEST $(DISC)/AlephOne/DEBUG $(DISC)/AlephOne/PROFILE
	echo on > $(DISC)/AlephOne/DEBUG
	$(MKDCDISC) -e $(TARGET) -d $(DISC)/AlephOne -o alephone-$(BUILD_TAG)-debug.cdi \
		-n "$(DISCNAME) $(BUILD_TAG) dbg" -a "$(DISCAUTH)"
	rm -f $(DISC)/AlephOne/DEBUG

# Padded like `cdi`, plus the PROFILE marker, which starts the VMU Profiler so
# a real framerate can be read off the VMU's LCD on hardware. Deliberately does
# not set DEBUG: the bfont traces draw over the 3D view.
cdi-profile: $(TARGET) $(DISC)/.stamp
	rm -f $(DISC)/AlephOne/AUTOSTART $(DISC)/AlephOne/PADTEST $(DISC)/AlephOne/DEBUG $(DISC)/AlephOne/PROFILE
	echo on > $(DISC)/AlephOne/PROFILE
	$(MKDCDISC) -e $(TARGET) -d $(DISC)/AlephOne -o alephone-$(BUILD_TAG)-profile.cdi \
		-n "$(DISCNAME) $(BUILD_TAG) prof" -a "$(DISCAUTH)"
	rm -f $(DISC)/AlephOne/PROFILE

gdi: $(TARGET) $(DISC)/.stamp
	rm -f $(DISC)/AlephOne/AUTOSTART $(DISC)/AlephOne/PADTEST $(DISC)/AlephOne/DEBUG $(DISC)/AlephOne/PROFILE
	$(MKDCDISC) -F gdi -e $(TARGET) -d $(DISC)/AlephOne -o alephone-$(BUILD_TAG).gdi \
		-s $(DISCSERIAL) -n "$(DISCNAME) $(BUILD_TAG)" -a "$(DISCAUTH)"

# Launch via `open` rather than exec'ing the binary: run straight from a shell,
# Flycast's dynarec VMEM init fails its own assertion in driver.cpp.
flycast: test
	open -a Flycast --args "$(CURDIR)/alephone-test.cdi"

clean:
	rm -f $(OBJS) $(OBJS:.o=.d) $(TARGET) dc/build_id.h

distclean: clean
	rm -rf $(DISC) alephone-*.cdi alephone-*.gdi track0*.*

.PHONY: all clean distclean disc test cdi cdi-debug cdi-profile gdi flycast

# Header dependencies generated by -MMD. The dash suppresses the "no such file"
# noise on a clean tree, where no .d files exist yet.
-include $(OBJS:.o=.d)
