# Makefile.dc -- Aleph One 0.12.0 for Sega Dreamcast
#
# Rewritten against modern KallistiOS (2026) from BERO's 2002 original.
# Build with:  source /opt/toolchains/dc/kos/environ.sh && make -f Makefile.dc
#
# What changed from BERO's version, and why:
#
#   * Uses kos-cc / kos-c++ and $(KOS_BASE)/Makefile.rules. BERO hard-coded
#     sh-elf-c++ -ml -m4-single-only plus manual include paths; KOS now ships
#     wrapper scripts that carry the correct arch flags, sysroot and libs.
#   * Dropped -fno-exceptions -fno-rtti. GCC 3 on SH-4 could not do C++
#     properly, which is why BERO rewrote try/catch as goto. Current dc-chain
#     GCC handles both, so those hacks can be reverted in the source.
#   * Dropped dc/syscalls.o and dc/fs_mem.o. KOS now has a real POSIX layer
#     and a romdisk, so his hand-written newlib syscalls and in-RAM VFS are
#     dead weight.
#   * Dropped -nostartfiles -Wl,-Ttext=0x8c010000 and the explicit startup.o.
#     Makefile.rules and the linker script handle load address and startup.
#   * Dropped the KOS kernel patch (MAX_ISO_FILES 8 -> 16). Modern KOS does
#     not carry that limit.
#
# -fpermissive and the -Wno-* set below are deliberate: this is 2001 C++ being
# fed to a C++17 compiler. `register`, writable string literals and implicit
# conversions are all over the tree. Tighten these later, not now.

# KOS_BASE and friends come from KallistiOS's environ.sh. Without it, the
# include below resolves to /Makefile.rules and make dies unhelpfully, so fail
# early with something actionable instead.
ifeq ($(strip $(KOS_BASE)),)
  $(error KOS_BASE is not set. Either run ./build.sh instead of make, or: \
    source /opt/toolchains/dc/kos/environ.sh)
endif

# Header dependency tracking. KOS's Makefile.rules only emits -MD when
# KOS_DEPDIR is set; with it unset it silently falls back to rules that track
# nothing, so editing a header rebuilds none of the objects that include it.
# That shipped stale key bindings to hardware: key_definitions.h was edited at
# 13:07 and vbl.o was still the 08:29 build, so the remapped movement keys
# never made it into the binary while unchanged bindings worked fine.
KOS_DEPDIR := .deps
$(shell mkdir -p $(KOS_DEPDIR))

TARGET     = alephone.elf
TARGET_BIN = 1ST_READ.BIN

# Data shipped inside the binary (MML scripts, Themes, Fonts).
# Game data (Map, Shapes, Sounds, Images) is far too big for this -- it stays
# on the GD-ROM / SD card and is read through the normal VFS.
KOS_ROMDISK_DIR = romdisk

CS = Source_Files/CSeries
EP = Source_Files/Expat
MI = Source_Files/Misc
NW = Source_Files/Network
PF = Source_Files/Pfhortran
MV = Source_Files/ModelView

# ---------------------------------------------------------------------------
# Flags
# ---------------------------------------------------------------------------

# Aleph One includes SDL headers flat (<SDL_endian.h>, not <SDL/SDL_endian.h>),
# but kos-ports installs them under include/SDL, so that dir goes on the path.
A1_INCS = -I$(CS) -I$(EP) -I$(MI) -I$(NW) -I$(PF) -I$(MV) -I$(KOS_PORTS)/include/SDL
# Deliberately NOT defining HAVE_SDL_NET_H or HAVE_SDL_IMAGE_H: neither port
# exists for KOS, and every use of them in the tree is guarded by those macros.
# Networking comes from network_dummy.cpp instead.
# PACKAGE/VERSION use plain double quotes, NOT BERO's '"..."'. These flags reach
# the compiler through the exported KOS_CFLAGS environment variable, and the
# kos-c++ wrapper expands it unquoted -- word-splitting happens but quotes are
# not reprocessed. So '"0.12.0"' arrives with the single quotes still attached
# and the preprocessor reads it as a multi-character constant.
A1_DEFS = -DSDL -DHAVE_UNISTD_H -DPACKAGE="AlephOne" -DVERSION="0.12.0" -DDC

A1_LEGACY = -fpermissive -Wno-register -Wno-write-strings -Wno-deprecated \
            -Wno-narrowing -Wno-conversion-null -Wno-invalid-offsetof

KOS_CFLAGS   += -O2 -fomit-frame-pointer $(A1_INCS) $(A1_DEFS)
# gnu++14, NOT gnu++17, and this is load-bearing. C++17 added std::byte, and
# Aleph One has its own ::byte typedef. BERO added 'using namespace std;' to
# FileHandler.h, resource_manager.h and sdl_dialogs.h to satisfy GCC 3, which
# drags std::byte into scope -- so under C++17 every 'byte' reference is
# ambiguous. That was 270 of 591 errors on the first build, plus a long tail of
# parse cascades behind it. C++14 has no std::byte, so the conflict vanishes
# without touching a single source file. Exceptions, RTTI and the STL are all
# still available.
KOS_CPPFLAGS += -std=gnu++14 $(A1_LEGACY)

# kos-ports installs SDL 1.2 as libSDL.a (verified after building the port).
SDL_LIBS = -lSDL

# GLdc gives OpenGL 1.x on the PowerVR2. BERO had no hardware GL at all and
# compiled the renderer out; this is the single biggest win available here.
# Start with the software renderer (GL unset), then flip GL=1.
ifdef GL
  KOS_CFLAGS += -DHAVE_OPENGL
  TARGET      = alephone_gl.elf
endif

# AUTOSTART=1 boots straight into a new game, skipping the main menu, so the
# renderer and controls can be tested without menu behaviour in the way.
# Use the 'autostart' target rather than setting this by hand -- changing a
# -D does not invalidate existing objects, so shell.o must be removed too.
ifdef AUTOSTART
  KOS_CFLAGS += -DDC_AUTOSTART
endif

# PROBE=1 replaces the 3D view with solid magenta to bisect the black-screen
# bug. See update_screen() in screen_sdl.cpp. Use the 'probe' target.
ifdef PROBE
  KOS_CFLAGS += -DDC_RENDER_PROBE
endif

# -lGL is NOT conditional on GL=1. kos-ports' SDL_dcvideo.c references glKosInit,
# glKosSwapBuffers and the whole glfuncs table unconditionally, so libSDL.a needs
# GLdc present at link time even for a pure software-renderer build. This is why
# the SDL port declares libGL as a hard dependency. -lGLU follows for gluScaleImage.
LIBS = $(SDL_LIBS) -lGL -lGLU -lm

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
#
# This list is BERO's, verified file-by-file against the SDL_release_0_12_0
# tag: all 97 present, none renamed. It encodes real decisions -- note
# network_dummy.cpp instead of the real networking stack, and no ModelView
# sources. Do not replace it with a wildcard.

SRCS = \
  $(CS)/byte_swapping.cpp $(CS)/csalerts_sdl.cpp $(CS)/cscluts_sdl.cpp \
  $(CS)/csmisc_sdl.cpp $(CS)/csstrings_sdl.cpp \
  \
  $(EP)/hashtable.c $(EP)/xmlparse.c $(EP)/xmlrole.c $(EP)/xmltok.c \
  \
  $(MI)/AnimatedTextures.cpp $(MI)/ChaseCam.cpp $(MI)/ColorParser.cpp \
  $(MI)/Crosshairs_SDL.cpp $(MI)/DamageParser.cpp $(MI)/FileHandler_SDL.cpp \
  $(MI)/FontHandler.cpp $(MI)/ImageLoader_SDL.cpp $(MI)/OGL_Render.cpp \
  $(MI)/OGL_Setup.cpp $(MI)/OverheadMap_SDL.cpp \
  $(MI)/OverheadMapRenderer.cpp $(MI)/PlayerName.cpp \
  $(MI)/RenderPlaceObjs.cpp $(MI)/RenderRasterize.cpp \
  $(MI)/RenderSortPoly.cpp $(MI)/RenderVisTree.cpp $(MI)/ShapesParser.cpp \
  $(MI)/TextStrings.cpp $(MI)/ViewControl.cpp $(MI)/XML_Configure.cpp \
  $(MI)/XML_DataBlock.cpp $(MI)/XML_ElementParser.cpp \
  $(MI)/XML_LevelScript.cpp $(MI)/XML_MakeRoot.cpp $(MI)/XML_Loader_SDL.cpp \
  $(MI)/computer_interface.cpp $(MI)/crc.cpp $(MI)/devices.cpp \
  $(MI)/dynamic_limits.cpp $(MI)/effects.cpp $(MI)/fades.cpp \
  $(MI)/find_files_sdl.cpp $(MI)/flood_map.cpp $(MI)/game_errors.cpp \
  $(MI)/game_wad.cpp $(MI)/game_window.cpp $(MI)/game_window_sdl.cpp \
  $(MI)/images.cpp $(MI)/import_definitions.cpp $(MI)/interface.cpp \
  $(MI)/interface_sdl.cpp $(MI)/items.cpp $(MI)/lightsource.cpp \
  $(MI)/map.cpp $(MI)/map_constructors.cpp $(MI)/marathon2.cpp \
  $(MI)/media.cpp $(MI)/monsters.cpp $(MI)/motion_sensor.cpp \
  $(MI)/mouse_sdl.cpp $(MI)/mysound.cpp $(MI)/overhead_map.cpp \
  $(MI)/pathfinding.cpp $(MI)/physics.cpp $(MI)/placement.cpp \
  $(MI)/platforms.cpp $(MI)/player.cpp $(MI)/preferences.cpp \
  $(MI)/preprocess_map_sdl.cpp $(MI)/projectiles.cpp $(MI)/render.cpp \
  $(MI)/resource_manager.cpp $(MI)/scenery.cpp $(MI)/scottish_textures.cpp \
  $(MI)/screen_drawing.cpp $(MI)/screen_sdl.cpp $(MI)/sdl_dialogs.cpp \
  $(MI)/sdl_fonts.cpp $(MI)/sdl_widgets.cpp $(MI)/shapes.cpp \
  $(MI)/shell.cpp $(MI)/textures.cpp $(MI)/vbl.cpp $(MI)/vbl_sdl.cpp \
  $(MI)/wad.cpp $(MI)/wad_sdl.cpp $(MI)/wad_prefs.cpp $(MI)/weapons.cpp \
  $(MI)/world.cpp $(MI)/shell_misc.cpp $(MI)/HUDRenderer.cpp \
  $(MI)/HUDRenderer_SW.cpp \
  \
  $(NW)/network_dummy.cpp $(NW)/network_games.cpp \
  \
  $(PF)/script_instructions.cpp $(PF)/script_parser.cpp $(PF)/scripting.cpp \
  \
  $(MI)/dc_compat.c $(MI)/dc_input.cpp

OBJS = $(patsubst %.c,%.o,$(patsubst %.cpp,%.o,$(SRCS))) romdisk.o

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

all: rm-elf $(TARGET)

include $(KOS_BASE)/Makefile.rules

# Makefile.rules ends with '-include $(wildcard $(KOS_DEPDIR)/*.md)', but names
# each dep file with $(patsubst %.c,%.md,...). That pattern does not match .cpp,
# so a C++ source yields a dep file still ending in .cpp -- generated correctly,
# listing the right headers, and then never included. With 93 of our 97 sources
# being C++, that is effectively no header tracking at all. Pick them up here.
# Worth reporting upstream to KallistiOS.
-include $(wildcard $(KOS_DEPDIR)/*.cpp)

# shell.cpp #includes shell_sdl.cpp -- 2001-style unity build, kept as-is.
$(MI)/shell.o: $(MI)/shell.cpp $(MI)/shell_sdl.cpp

# weapons.cpp must be built at -O1. At -O2, GCC 15.2's SH backend emits
#     mov     #38,r1
#     mul.l   r1,r8
#     mov.w   r0,@(10,macl)
# using MACL -- the multiply-accumulate result register -- as the base register
# of a displacement address. SH-4 allows only R0-R15 there, so binutils rejects
# it with "syntax error in @(disp,[Rn, gbr, pc])". The result should be moved
# out with 'sts macl,rN' first. This is a compiler bug, not a source problem:
# -O1, -Os and -O0 all assemble cleanly. Verified as the only affected file.
$(MI)/weapons.o: KOS_CFLAGS := $(subst -O2,-O1,$(KOS_CFLAGS))

$(TARGET): $(OBJS)
	kos-c++ -o $(TARGET) $(OBJS) $(LIBS)

# Scratch build of a single file, for chasing one error at a time:
#   make -f Makefile.dc one FILE=Source_Files/Misc/map.cpp
one:
	kos-c++ $(KOS_CFLAGS) $(KOS_CPPFLAGS) -c $(FILE) -o /dev/null

$(TARGET_BIN): $(TARGET)
	$(KOS_STRIP) $(TARGET)
	kos-objcopy -O binary -R .stack $(TARGET) $(TARGET_BIN).unscrambled
	scramble $(TARGET_BIN).unscrambled $(TARGET_BIN)

bin: $(TARGET_BIN)

# ---------------------------------------------------------------------------
# Disc images
# ---------------------------------------------------------------------------
#
# mkdcdisc handles the ELF -> scrambled 1ST_READ.BIN -> IP.BIN -> image chain
# that BERO's README did by hand with mkisofs -l -J plus cdi4dc.
#
#   make -f Makefile.dc cdi   -> padded .cdi, burn or feed to GDEMU
#   make -f Makefile.dc test  -> unpadded .cdi, ~20MB, for Flycast iteration
#   make -f Makefile.dc gdi   -> .gdi, GDEMU's native format
#
# disc/AlephOne must hold both the engine data (MML, Themes, Fonts) and the
# scenario (Map, Shapes, Sounds, Images). -d adds the tree root included, so it
# lands at /AlephOne, matching default_data_dir = "/cd/AlephOne".

MKDCDISC   = /opt/toolchains/dc/mkdcdisc/build/mkdcdisc
DISC_DIR   = disc/AlephOne
DISC_META  = -n "Aleph One" -a "Aleph One" -V "ALEPHONE"

cdi: $(TARGET)
	$(MKDCDISC) -e $(TARGET) -d $(DISC_DIR) -o alephone.cdi $(DISC_META)

# -N drops the track padding. Padding speeds real-hardware loading but inflates
# the image from ~21MB to ~740MB, which is intolerable for a build-test loop.
test: $(TARGET)
	$(MKDCDISC) -e $(TARGET) -d $(DISC_DIR) -o alephone-test.cdi $(DISC_META) -N

gdi: $(TARGET)
	$(MKDCDISC) -F gdi -e $(TARGET) -d $(DISC_DIR) -o alephone.gdi $(DISC_META)

# Straight-to-level build, for testing rendering and controls in isolation.
# Removes shell.o first: adding -DDC_AUTOSTART does not by itself make the
# object stale, so without this the flag would silently have no effect.
# Variant targets. Each one removes the objects the variant's -D affects,
# because a changed -D does NOT make an object stale -- 'make cdi' straight
# after 'make autostart' silently reuses the autostart shell.o and produces a
# mislabelled image. Each target then asserts on the built binary that it got
# what it asked for, so a mix-up fails the build instead of reaching hardware.

NM = $(KOS_BASE)/../sh-elf/bin/sh-elf-nm

menu:
	-rm -f $(MI)/shell.o $(MI)/screen_sdl.o $(TARGET) alephone.cdi alephone-menu.cdi
	$(MAKE) -f Makefile.dc cdi
	@$(NM) $(TARGET) | grep -q dc_autostart_active \
		&& { echo "BUILD ERROR: menu build contains autostart marker"; exit 1; } || true
	@$(NM) $(TARGET) | grep -q dc_render_probe_active \
		&& { echo "BUILD ERROR: menu build contains render probe"; exit 1; } || true
	cp alephone.cdi alephone-menu.cdi
	@echo "OK: alephone-menu.cdi is a menu build, real renderer"

autostart:
	-rm -f $(MI)/shell.o $(MI)/screen_sdl.o $(TARGET) alephone-test.cdi alephone.cdi alephone-autostart.cdi
	$(MAKE) -f Makefile.dc test AUTOSTART=1
	$(MAKE) -f Makefile.dc cdi  AUTOSTART=1
	@$(NM) $(TARGET) | grep -q dc_autostart_active \
		|| { echo "BUILD ERROR: autostart build lacks autostart marker"; exit 1; }
	@$(NM) $(TARGET) | grep -q dc_render_probe_active \
		&& { echo "BUILD ERROR: autostart build contains render probe"; exit 1; } || true
	cp alephone.cdi alephone-autostart.cdi
	@echo "OK: alephone-autostart.cdi skips the menu, real renderer"

# Autostart + magenta 3D view. Answers whether the presentation path works at
# all, independently of what the renderer produces.
probe:
	-rm -f $(MI)/shell.o $(MI)/screen_sdl.o $(TARGET) alephone-test.cdi alephone.cdi
	$(MAKE) -f Makefile.dc test AUTOSTART=1 PROBE=1
	$(MAKE) -f Makefile.dc cdi  AUTOSTART=1 PROBE=1

# Say what a built ELF actually is. Flags that silently fail to take effect have
# cost several hardware test rounds, so variant is reported from the binary's
# marker symbols rather than from which command was typed.
verify:
	@echo "$(TARGET):"
	@$(KOS_BASE)/../sh-elf/bin/sh-elf-nm $(TARGET) | grep -q dc_autostart_active \
		&& echo "  menu      : NO  (boots straight into a new game)" \
		|| echo "  menu      : YES (starts at the main menu)"
	@$(KOS_BASE)/../sh-elf/bin/sh-elf-nm $(TARGET) | grep -q dc_render_probe_active \
		&& echo "  3D view   : MAGENTA PROBE (not the real renderer)" \
		|| echo "  3D view   : real renderer"

# 'open -a' rather than running the binary directly. Flycast reserves a large
# contiguous virtual address range for its 16MB guest RAM (nvmem); launched from
# some shell contexts that reservation fails and it aborts on an internal assert
# -- "&mem_b[0] == sq_buffer + sizeof(Sh4Context) + 0x0C000000" in driver.cpp.
# Going through LaunchServices gives it a clean process environment.
flycast: test
	open -a Flycast --args "$(CURDIR)/alephone-test.cdi"

run: $(TARGET)
	$(KOS_LOADER) $(TARGET)

rm-elf:
	-rm -f $(TARGET) $(TARGET).bin $(TARGET_BIN) romdisk.*

clean: rm-elf
	-rm -f $(OBJS)

.PHONY: all bin run rm-elf clean one cdi test gdi flycast menu autostart probe verify
