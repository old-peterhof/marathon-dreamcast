+/* These four return a channel in 0-255, not the raw 0-15 nibble, because
+   PACK_ARGB4444 below them is a 0-255 -> 0-15 packer: _PACK4(v) is
+   (v * 0xF) / 0xFF. Feeding it a nibble makes every channel zero -- for any
+   n <= 16, n * 15 <= 240, which is less than 255, so the integer division
+   truncates to 0 for every possible input including 15. Every ARGB4444 mip
+   texel came out 0x0000, transparent black, and with alpha testing on the
+   polygon vanished or went black at whichever level the PVR selected.
+
+   The 1555 and 565 readers beside these already expand to 0-255 (R1555 shifts
+   >> 7, PACK_RGB565 masks 0xf8), so 4444 was the odd one out and the readers
+   are the correct side to change: PACK_ARGB4444's other caller, the palette
+   path in texture.c, passes it 0-255 GLubyte components and would break if the
+   macro's domain changed.
+
+   Nibble replication, n -> (n << 4) | n, maps 0 to 0 and 15 to 255. */
 GL_FORCE_INLINE GLuint A4444(GLuint v) {
-    const GLuint MASK = (0xF << 12);
-    return (v & MASK) >> 12;
+    const GLuint n = (v >> 12) & 0xF;
+    return (n << 4) | n;
